# =============================================================================
# Phoenix Self-Healing Platform — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to version control.
# =============================================================================

# --- MongoDB ---
# Format: mongodb://localhost:27017 or mongodb+srv://<username>:<password>@cluster0.example.mongodb.net
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=phoenix

# --- Grok AI (runtime agent advisor) ---
GROK_API_KEY=your_grok_api_key_here
GROK_MODEL=grok-3-mini
GROK_ENABLED=true

# --- xAI LLM Engine (code-level diagnosis + patch generation) ---
# Used by agent/ai/llm_engine/ — must be set to enable the LLM Engine.
# Get your key at: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here
# Optional: override the model (default: llama-3.3-70b-versatile)
# GROQ_MODEL=llama-3.3-70b-versatile

# --- Backend ---
BACKEND_URL=http://phoenix-backend:5000
SECRET_KEY=your_secret_key_here
CORS_ORIGINS=http://localhost:3000,http://phoenix-frontend:3000
FLASK_ENV=development

# --- Agent ---
DOCKER_SOCKET=unix:///var/run/docker.sock

# Per-collector poll intervals (seconds)
POLL_DOCKER_SECONDS=2
POLL_HEALTH_SECONDS=5
POLL_DB_SECONDS=10
POLL_REDIS_SECONDS=10
POLL_LOGS_SECONDS=20

# Recovery
ESCALATION_THRESHOLD=3          # retries before escalation
RECOVERY_TIMEOUT_SECONDS=60     # max wait for container to become healthy

# --- Phoenix Orchestrator (Person 5) ---

# Webhook security: secret shared between GitHub Actions and Phoenix API
# Set this to a strong random string (e.g. openssl rand -hex 32)
PHOENIX_WEBHOOK_SECRET=your-super-secret-webhook-token-here

# Local repository path that Phoenix will patch and validate
# Must be a local Git clone of the target repository
# Will be mounted into the phoenix-api container
PHOENIX_REPO_PATH=/tmp/phoenix-repo

# Max number of diagnosis+patch+validate attempts before giving up
PHOENIX_MAX_ATTEMPTS=2

# Git commit author identity (used when Phoenix commits the fix)
PHOENIX_GIT_AUTHOR_NAME=Phoenix Bot
PHOENIX_GIT_AUTHOR_EMAIL=phoenix@example.com

# --- Sandbox / Validation / Git (Person 4) ---

# Docker sandbox timeouts (seconds)
SANDBOX_DOCKER_TIMEOUT=180
SANDBOX_CONTAINER_STARTUP_TIMEOUT=30

# Lint / test step timeouts (seconds)
SANDBOX_LINT_TIMEOUT=60
SANDBOX_TEST_TIMEOUT=120

# Feature flags — set to false to skip steps in lightweight/offline runs
SANDBOX_RUN_LINT=true
SANDBOX_RUN_TESTS=true
SANDBOX_RUN_DOCKER=true
SANDBOX_SKIP_DOCKER_IF_UNAVAILABLE=true

# GitHub integration — required for branch push + PR creation
# GITHUB_REPO must be "owner/repo" format, e.g. myorg/phoenix
GITHUB_REPO=your_org/your_repo
GITHUB_BASE_BRANCH=main
# GitHub Personal Access Token (scope: repo for private, public_repo for public)
GITHUB_TOKEN=your_github_pat_here

# --- Monitored Services (sample-app defaults) ---
SAMPLE_BACKEND_URL=http://sample-backend:8080
SAMPLE_BACKEND_CONTAINER=phoenix-sample-backend-1
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=sampleuser
POSTGRES_PASSWORD=samplepassword
POSTGRES_DB=sampledb
REDIS_HOST=redis
REDIS_PORT=6379
